# ====================================
# PLATAFORMA FISCAL COLABORATIVA
# Variables de Entorno
# ====================================

# ====================================
# DESARROLLO LOCAL
# ====================================

# Session Secret (mínimo 32 caracteres)
# Genera uno nuevo con: openssl rand -base64 32
NUXT_SESSION_SECRET=change-this-to-a-random-32-char-secret-key-for-development

# Base de datos local (SQLite para desarrollo)
DATABASE_PATH=./local.db

# ====================================
# PRODUCCIÓN (Cloudflare)
# ====================================

# D1 Database ID (obtener con: wrangler d1 list)
DATABASE_ID=your-d1-database-id

# Account ID de Cloudflare (Dashboard > Workers & Pages > Account ID)
CF_ACCOUNT_ID=your-cloudflare-account-id

# API Token (Dashboard > My Profile > API Tokens > Create Token)
# Permisos necesarios: Workers, Pages, D1
CF_API_TOKEN=your-cloudflare-api-token

# KV Namespace ID (opcional - para caché)
KV_NAMESPACE=your-kv-namespace-id

# R2 Bucket (opcional - para almacenar facturas)
R2_BUCKET_NAME=facturas-storage

# ====================================
# CONFIGURACIÓN OPCIONAL
# ====================================

# Ambiente
NODE_ENV=development

# Puerto local
PORT=3000

# Sentry (error monitoring - gratis hasta 10k eventos/mes)
# Obtén tu DSN en: https://sentry.io/settings/projects/
NUXT_PUBLIC_SENTRY_DSN=

# ====================================
# WEBAUTHN / 2FA CONFIGURATION
# ====================================
# REQUERIDO para autenticación de dos factores

# Relying Party ID (tu dominio sin protocolo)
# Desarrollo: localhost
# Producción: tu-dominio.pages.dev
NUXT_PUBLIC_RP_ID=localhost

# Relying Party Name (nombre visible para el usuario)
NUXT_PUBLIC_RP_NAME=Plataforma Fiscal

# Relying Party Origin (URL completa)
# Desarrollo: http://localhost:3000
# Producción: https://tu-dominio.pages.dev
NUXT_PUBLIC_RP_ORIGIN=http://localhost:3000

# ====================================
# EMAIL SERVICE
# ====================================

# MailChannels (GRATIS en Cloudflare Workers - RECOMENDADO)
# No requiere API key cuando se usa desde Cloudflare Workers
# Documentación: https://blog.cloudflare.com/sending-email-from-workers-with-mailchannels/
EMAIL_SERVICE=mailchannels
EMAIL_FROM=noreply@tu-dominio.com
EMAIL_FROM_NAME=Plataforma Fiscal

# SendGrid (alternativa - gratis hasta 100 emails/día)
# SENDGRID_API_KEY=your-sendgrid-api-key

# Postmark (alternativa - gratis hasta 100 emails/mes)
# POSTMARK_API_KEY=your-postmark-api-key

# ====================================
# LÍMITES DEL TIER GRATUITO CLOUDFLARE
# ====================================
#
# Pages:
# - 500 builds/mes
# - 100,000 requests/día
# - Bandwidth ilimitado
#
# D1 Database:
# - 10 GB almacenamiento
# - 5M filas leídas/día
# - 100K filas escritas/día
#
# Workers:
# - 100,000 requests/día
#
# KV:
# - 100,000 reads/día
# - 1,000 writes/día
#
# R2:
# - 10 GB almacenamiento
# - Sin costos de egress
#
# ====================================
# INSTRUCCIONES
# ====================================
#
# 1. Copia este archivo a .env:
#    cp .env.example .env
#
# 2. Genera un secret seguro:
#    openssl rand -base64 32
#
# 3. NUNCA commitees el archivo .env
#    (ya está en .gitignore)
#
# 4. En producción (Cloudflare Pages):
#    Dashboard > Pages > Tu Proyecto > Settings > Environment variables
#
