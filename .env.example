# Session secret for encryption (generate with: openssl rand -base64 32)
NUXT_SESSION_SECRET=your-secret-key-here

# Cloudflare D1 Database ID
DATABASE_ID=your-d1-database-id

# Cloudflare KV Namespace ID
KV_NAMESPACE=your-kv-namespace-id

# Optional: Supabase Auth (if using)
SUPABASE_URL=
SUPABASE_ANON_KEY=
