{
  "name": "plataforma-fiscal-colaborativa",
  "version": "1.0.0",
  "description": "Plataforma de Declaraciones Fiscales Colaborativas",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,ts,vue,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "pages:deploy": "npm run build && wrangler pages deploy"
  },
  "dependencies": {
    "@iconify-json/heroicons": "^1.2.1",
    "@iconify-json/lucide": "^1.2.9",
    "@lucia-auth/adapter-sqlite": "^3.0.2",
    "@nuxt/ui": "^2.19.2",
    "@pinia/nuxt": "^0.5.5",
    "@tanstack/vue-query": "^5.62.2",
    "drizzle-orm": "^0.36.4",
    "lucia": "^3.2.1",
    "nuxt": "^3.14.159",
    "oslo": "^1.2.1",
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@nuxt/eslint": "^0.7.0",
    "@nuxt/test-utils": "^3.14.3",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.9.3",
    "@vue/test-utils": "^2.4.6",
    "drizzle-kit": "^0.29.1",
    "eslint": "^9.15.0",
    "happy-dom": "^15.11.7",
    "playwright-core": "^1.49.0",
    "prettier": "^3.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.5",
    "wrangler": "^3.90.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
